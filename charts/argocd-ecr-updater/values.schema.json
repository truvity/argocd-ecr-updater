{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "argocd-ecr-updater chart values",
  "description": "Strict at the top level and inside every object the chart defines: unknown keys are rejected so a typo fails the render instead of being silently ignored. Kubernetes passthrough fields (tolerations) stay open.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "schedule", "awsRegion", "registries"],
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "schedule": { "type": "string", "minLength": 1 },
    "awsRegion": { "type": "string", "minLength": 1 },
    "registries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secret", "url"],
        "properties": {
          "secret": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^oci://" }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": { "type": "array" }
  }
}
